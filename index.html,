
<!DOCTYPE html>
<html lang="ky">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#781d32">
<title>Жылдыздын кыз узатуу тою</title>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --burgundy: #781d32;
  --dark: #4d1020;
  --gold: #c7a45d;
  --gold-light: #e8d5a4;
  --milk: #fff7e9;
  --ink: #38251e;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--milk);
  color: var(--ink);
  font-family: "Manrope", sans-serif;
}

body.locked { overflow: hidden; }

button { font: inherit; cursor: pointer; }

h1, h2, .script {
  font-family: "Cormorant Garamond", Georgia, serif;
}

.intro {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 20px;
  background:
    linear-gradient(rgba(48,8,19,.6), rgba(48,8,19,.85)),
    url("assets/yurt.jpg") center/cover,
    var(--dark);
  transition: opacity .8s, visibility .8s;
}

.intro.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.intro-card {
  width: min(100%, 420px);
  min-height: 540px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 19px;
  padding: 35px 24px;
  text-align: center;
  color: var(--milk);
  border: 1px solid var(--gold);
  background: linear-gradient(145deg, #781d32f2, #4d1020f7);
  box-shadow: 0 24px 80px #0006;
}

.intro-card::before {
  content: "";
  position: absolute;
  inset: 10px;
  border: 1px solid #c7a45d99;
  pointer-events: none;
}

.eyebrow {
  color: var(--gold-light);
  letter-spacing: .15em;
  font-size: .7rem;
  text-transform: uppercase;
}

.envelope {
  width: 190px;
  height: 135px;
  position: relative;
  border: 1px solid var(--gold);
  background: #f7ecd7;
  margin: 8px 0;
  box-shadow: 0 12px 24px #0004;
  transition: transform .4s;
}

.envelope:hover { transform: translateY(-4px); }

.envelope::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(145deg, transparent 49%, #c7a45d 50%, transparent 51%),
    linear-gradient(35deg, transparent 49%, #d8bd83 50%, transparent 51%);
}

.flap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 70px;
  background: #e7d4ad;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: top;
  transition: transform .7s;
  z-index: 2;
}

.envelope.opened .flap {
  transform: rotateX(180deg);
}

.seal {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%);
  width: 43px;
  height: 43px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--milk);
  background: var(--burgundy);
  border: 2px solid var(--gold);
  font-size: 20px;
}

.open-button, .gold-button {
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 13px 22px;
  color: var(--milk);
  background: linear-gradient(135deg, #9a3349, var(--dark));
  box-shadow: 0 7px 20px #0003;
  text-decoration: none;
}

.tiny-note {
  font-size: .75rem;
  color: #e7d7c2;
  max-width: 260px;
  line-height: 1.6;
}

main {
  opacity: 0;
  transition: opacity 1s;
}

main.visible { opacity: 1; }

.hero {
  min-height: 100svh;
  position: relative;
  display: grid;
  place-items: center;
  padding: 35px 18px;
  background: radial-gradient(ellipse at top, #fffaf0, #f2e4cf);
}

.hero::before {
  content: "❦";
  position: absolute;
  top: 18px;
  color: var(--gold);
  font-size: 35px;
}

.hero-inner {
  width: min(100%, 540px);
  text-align: center;
  padding: 35px 22px;
  border: 1px solid var(--gold);
  background: #fff7e9dd;
  box-shadow: 0 18px 60px #532d251f;
}

.hero-photo {
  display: block;
  width: min(75%, 300px);
  aspect-ratio: 3/4;
  object-fit: cover;
  object-position: center 25%;
  margin: 20px auto;
  border: 5px solid #fffaf0;
  outline: 1px solid var(--gold);
  box-shadow: 0 12px 28px #461c1c2e;
}

h1 {
  margin: 5px 0;
  font-size: clamp(3.5rem, 14vw, 5.8rem);
  line-height: .95;
  color: var(--burgundy);
  font-weight: 500;
}

.subtitle {
  color: #8e6a34;
  font-size: .8rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  margin: 15px 0;
}

.intro-copy {
  max-width: 430px;
  margin: 20px auto;
  font-size: .94rem;
  line-height: 1.9;
}

.section { padding: 70px 20px; }

.section-inner {
  width: min(100%, 720px);
  margin: auto;
}

.section-title {
  margin: 0 0 15px;
  text-align: center;
  color: var(--burgundy);
  font-size: clamp(2.2rem, 8vw, 3.2rem);
  font-weight: 500;
}

.section-lead {
  text-align: center;
  color: #816c60;
  line-height: 1.8;
  max-width: 520px;
  margin: 0 auto 30px;
}

.details {
  background: var(--burgundy);
  color: var(--milk);
  position: relative;
  text-align: center;
  overflow: hidden;
}

.details::before {
  content: "";
  position: absolute;
  inset: 0;
  background: url("assets/yurt.jpg") center/cover;
  opacity: .12;
}

.details .section-inner {
  position: relative;
}

.details .section-title {
  color: var(--gold-light);
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 30px 0;
}

.detail-card {
  border: 1px solid #c7a45db3;
  padding: 22px 12px;
  background: #3708143d;
  min-height: 140px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 9px;
}

.detail-icon {
  color: var(--gold-light);
  font-size: 1.5rem;
}

.detail-label {
  color: #e3cda0;
  font-size: .72rem;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.detail-value {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 1.5rem;
}

.wide { grid-column: 1 / -1; }

.photo-break {
  min-height: 320px;
  background:
    linear-gradient(#410c182e, #410c1873),
    url("assets/jewelry.jpg") center/cover;
  display: grid;
  place-items: center;
  padding: 35px 20px;
}

.photo-quote {
  width: min(100%, 520px);
  text-align: center;
  color: var(--milk);
  padding: 25px 20px;
  border: 1px solid var(--gold);
  background: #4d10209c;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(1.6rem, 5vw, 2.3rem);
  line-height: 1.4;
}

.footer {
  background: #f1e2ca;
  text-align: center;
  padding: 45px 20px;
}

.footer .script {
  font-size: 2rem;
  color: var(--burgundy);
}

.small {
  font-size: .78rem;
  color: #816c60;
}

.music-toggle {
  position: fixed;
  right: 16px;
  bottom: 16px;
  z-index: 10;
  display: none;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  border: 1px solid var(--gold);
  border-radius: 999px;
  color: var(--milk);
  background: var(--burgundy);
  box-shadow: 0 5px 20px #0003;
  font-size: .8rem;
}

.music-toggle.show { display: flex; }

.music-dot {
  width: 8px;
  height: 8px;
  background: var(--gold-light);
  border-radius: 50%;
}

@media (max-width: 430px) {
  .intro-card { min-height: 510px; }
  .detail-grid { gap: 9px; }
  .detail-card { padding: 18px 8px; }
  .detail-value { font-size: 1.25rem; }
  .hero-inner { padding: 28px 15px; }
}
</style>
</head>

<body class="locked">

<!-- АЧЫЛГАНДА БИРИНЧИ КӨРҮНҮҮЧҮ КОНВЕРТ -->
<section class="intro" id="intro">
  <div class="intro-card">
    <div class="eyebrow">Улуттук салт • Ак тилек</div>

    <p class="script" style="font-size:1.55rem;margin:0;color:var(--gold-light)">
      Сизге атайын чакыруу
    </p>

    <button class="envelope" id="envelope" aria-label="Конвертти ачуу">
      <span class="flap"></span>
      <span class="seal">❦</span>
    </button>

    <h1 style="font-size:3.5rem;color:var(--milk);margin:0">Жылдыз</h1>

    <p style="margin:0;color:var(--gold-light);letter-spacing:.12em">
      КЫЗ УЗАТУУ ТОЮ
    </p>

    <button class="open-button" id="openInvitation">
      Чакыруу катын ачуу ↗
    </button>

    <p class="tiny-note">
      Конвертти ачып, кубанычыбызга күбө болуңуз.
    </p>
  </div>
</section>

<!-- НЕГИЗГИ ЧАКЫРУУ САЙТЫ -->
<main id="main">

  <section class="hero">
    <div class="hero-inner">
      <div class="eyebrow">Ак жол • Ак бата • Ак тилек</div>

      <img
        class="hero-photo"
        src="assets/jyldyz-portrait.jpg"
        alt="Жылдыз улуттук кийимде"
      >

      <h1>Жылдыз</h1>

      <p class="subtitle">Кыз узатуу тоюна чакыруу</p>

      <p class="intro-copy">
        Урматтуу туугандар, жакындар жана кадырлуу коноктор!<br><br>
        Сиздерди кызыбыз Жылдыздын кыз узатуу тоюна чакырабыз.
        Бул өзгөчө күнү кубанычыбызды тең бөлүшүп,
        ак баталарыңызды берип, төрүбүздүн көркүн ачып кетиңиздер!
      </p>

      <div class="script" style="font-size:1.5rem;color:var(--gold)">
        ❦ Сиздерди күтөбүз! ❦
      </div>
    </div>
  </section>

  <!-- ТОЙДУН МААЛЫМАТЫ -->
  <section class="section details" id="details">
    <div class="section-inner">
      <p class="eyebrow">Маанилүү күн</p>

      <h2 class="section-title">Тойдун маалыматы</h2>

      <p style="line-height:1.8;color:#f3e5cf">
        Кубанычыбызды бирге бөлүшүүгө чакырабыз
      </p>

      <div class="detail-grid">
        <div class="detail-card">
          <div class="detail-icon">✧</div>
          <div class="detail-label">Күнү</div>
          <div class="detail-value">15-ноябрь<br>2026-жыл</div>
        </div>

        <div class="detail-card">
          <div class="detail-icon">◷</div>
          <div class="detail-label">Башталышы</div>
          <div class="detail-value">15:00</div>
        </div>

        <div class="detail-card wide">
          <div class="detail-icon">⌖</div>
          <div class="detail-label">Өтүүчү жери</div>
          <div class="detail-value">Ала-Тоо рестораны</div>
          <div>Бишкек шаары</div>
        </div>
      </div>

      <a
        class="gold-button"
        href="https://www.google.com/maps/search/?api=1&query=Ala-Too+Restaurant+Bishkek"
        target="_blank"
        rel="noopener noreferrer"
      >
        Картадан көрүү ↗
      </a>

      <p class="small" style="color:#e7d7c2;margin-top:14px">
        Карта ресторандын аталышы боюнча издейт.
        Так дарек берилсе, шилтемени жаңыртабыз.
      </p>
    </div>
  </section>

  <!-- УЛУТТУК СҮРӨТ ЖАНА КААЛОО -->
  <section class="photo-break">
    <div class="photo-quote">
      «Кыз — үйдүн куту, ак батасы — жолдун жарыгы»
    </div>
  </section>

  <section class="section">
    <div class="section-inner" style="text-align:center">
      <h2 class="section-title">Ак тилегибиз</h2>

      <p class="section-lead">
        Кызыбыздын жаңы жашоо жолуна ак тилек айтып,
        жакшы ниетиңиздер менен бөлүшүп кетиңиздер.
        Сиздердин келгениңиздер биз үчүн чоң сыймык.
      </p>

      <img
        src="assets/invitation-frame.jpg"
        alt="Алтын оймо-чиймелүү чакыруу алкагы"
        style="display:block;width:min(100%,340px);max-height:440px;object-fit:cover;margin:0 auto;border:1px solid var(--gold)"
      >

      <p class="script" style="font-size:1.7rem;color:var(--burgundy);margin-top:25px">
        Урматтоо менен, Айнагүл жана үй-бүлөсү
      </p>
    </div>
  </section>

  <footer class="footer">
    <div class="script">Жылдыздын кыз узатуу тою</div>
    <p>15-ноябрь, 2026-жыл • 15:00</p>
    <p class="small">Бишкек шаары · Ала-Тоо рестораны</p>
    <div style="color:var(--gold);font-size:1.4rem;margin-top:18px">❦</div>
  </footer>

</main>

<!-- МУЗЫКАНЫ БАШКАРУУ -->
<button class="music-toggle" id="musicToggle">
  <span class="music-dot"></span>
  <span id="musicLabel">Музыка күйгүзүү</span>
</button>

<audio id="komuz" src="assets/komuz.mp3" preload="none" loop></audio>

<script>
const intro = document.getElementById("intro");
const envelope = document.getElementById("envelope");
const openButton = document.getElementById("openInvitation");
const main = document.getElementById("main");
const audio = document.getElementById("komuz");
const musicToggle = document.getElementById("musicToggle");
const musicLabel = document.getElementById("musicLabel");

let opened = false;

async function openSite() {
  if (opened) return;
  opened = true;

  envelope.classList.add("opened");
  openButton.textContent = "Чакыруу ачылууда…";

  // Музыка конок баскандан кийин башталат.
  try {
    await audio.play();
    musicLabel.textContent = "Музыканы өчүрүү";
  } catch (error) {
    musicLabel.textContent = "Музыка күйгүзүү";
  }

  document.body.classList.remove("locked");
  main.classList.add("visible");
  musicToggle.classList.add("show");

  window.setTimeout(() => {
    intro.classList.add("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }, 700);
}

openButton.addEventListener("click", openSite);
envelope.addEventListener("click", openSite);

musicToggle.addEventListener("click", async () => {
  if (audio.paused) {
    try {
      await audio.play();
      musicLabel.textContent = "Музыканы өчүрүү";
    } catch (error) {
      musicLabel.textContent = "Музыка файлын текшериңиз";
    }
  } else {
    audio.pause();
    musicLabel.textContent = "Музыка күйгүзүү";
  }
});
</script>

</body>
</html>
